# cPanel / Production Database Configuration
# Copy this file to .env and fill in your cPanel database details

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_invoit
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_secure_password

# Port for Node.js app (cPanel assigns this automatically via process.env.PORT)
PORT=3000
